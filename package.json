{
  "name": "securebank",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @securebank/web",
    "dev:admin": "npm run dev --workspace @securebank/admin",
    "dev:mobile": "npm run start --workspace @securebank/mobile",
    "build": "npm run build --workspace @securebank/web && npm run build --workspace @securebank/admin",
    "build:mobile": "npm run export --workspace @securebank/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "format:check": "prettier --check apps packages docs infrastructure scripts tests .github *.json *.yml *.md",
    "security:check": "node scripts/check-dependencies.mjs",
    "check:toolchain": "node scripts/check-toolchain.cjs",
    "test:performance": "node --env-file-if-exists=.env scripts/performance.mjs",
    "format": "prettier --write apps packages docs infrastructure scripts tests .github *.json *.yml *.md"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-native-gesture-handler": "2.32.0",
    "react-native-screens": "4.26.2",
    "uuid": "11.1.1"
  }
}
