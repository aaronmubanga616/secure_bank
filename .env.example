# Copy to .env and replace every value marked CHANGE_ME.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
POSTGRES_DB=securebank
POSTGRES_USER=securebank
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
JWT_SECRET=CHANGE_ME_BASE64_AT_LEAST_32_RANDOM_BYTES
# Exactly 32 random bytes, base64 encoded, for AES-GCM.
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_RANDOM_BYTES
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GATEWAY_PORT=8088
ADMIN_PORT=8089
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8088,http://localhost:8089
# Enable only on your local development machine.
API_DOCS_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
CUSTOMER_WEB_URL=http://localhost:5173
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:8088/api/v1
